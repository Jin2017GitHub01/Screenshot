<Window x:Class="Screenshot.RecordingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording Video"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border x:Name="PillBorder" Margin="10" CornerRadius="14" Padding="14,8"
            Background="#F21A1C26" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
            Cursor="SizeAll" ToolTip="Drag to move • Excluded from video capture">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Pulsing recording dot -->
            <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="{StaticResource RecordBrush}"
                     VerticalAlignment="Center" Margin="0,0,9,0"/>

            <!-- Elapsed time -->
            <TextBlock x:Name="TimerText" Text="0:00" Foreground="{StaticResource TextBrush}"
                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       MinWidth="36"/>

            <!-- Live system-audio meter -->
            <Border x:Name="LevelMeter" Width="46" Height="6" CornerRadius="3" Margin="8,0,12,0"
                    VerticalAlignment="Center" Background="#30FFFFFF" ClipToBounds="True"
                    ToolTip="System audio level">
                <Border x:Name="LevelFill" HorizontalAlignment="Left" Width="0" CornerRadius="3"
                        Background="{StaticResource SuccessBrush}"/>
            </Border>

            <!-- Stop button -->
            <Button x:Name="StopButton" Style="{StaticResource BaseButton}"
                    Background="{StaticResource RecordBrush}" BorderBrush="{StaticResource RecordBrush}"
                    Foreground="White" Padding="12,5" FontSize="12"
                    Click="StopButton_Click" ToolTip="Stop recording and save MP4 (Ctrl+Shift+R)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StopText" Text="Stop" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>

