<Window x:Class="Screenshot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture Everything" Width="980" Height="660" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="&#xE7A8;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Capture Everything" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Catch every pixel" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RecordButton" Style="{StaticResource BaseButton}" Padding="18,11" FontSize="14"
                        Click="RecordButton_Click" ToolTip="Record the sound playing on this computer (Ctrl+R)">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="White" Margin="0,0,9,0"
                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="RecordIcon" Text="&#xE767;" Style="{StaticResource IconText}"/>
                        <TextBlock x:Name="RecordLabel" Text="Record Audio"/>
                        <!-- Live level meter (visible while recording) -->
                        <Border x:Name="LevelMeter" Width="54" Height="6" CornerRadius="3" Margin="10,0,0,0"
                                VerticalAlignment="Center" Background="#40FFFFFF" Visibility="Collapsed" ClipToBounds="True">
                            <Border x:Name="LevelFill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="White"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Button x:Name="VideoButton" Style="{StaticResource BaseButton}" Padding="18,11" FontSize="14" Margin="10,0,0,0"
                        Click="VideoButton_Click" ToolTip="Record screen video with system audio (Ctrl+Shift+R)">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="VideoDot" Width="10" Height="10" Fill="White" Margin="0,0,9,0"
                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="VideoIcon" Text="&#xE714;" Style="{StaticResource IconText}"/>
                        <TextBlock x:Name="VideoLabel" Text="Record Video"/>
                    </StackPanel>
                </Button>

                <Button x:Name="CaptureButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        Click="CaptureButton_Click" ToolTip="New capture (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE722;" Style="{StaticResource IconText}"/>
                        <TextBlock Text="New Capture"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Preview card -->
        <Border Grid.Row="1" Margin="0,18" CornerRadius="16" BorderThickness="1"
                BorderBrush="{StaticResource StrokeBrush}" Background="{StaticResource CheckerBrush}">
            <Grid ClipToBounds="True">
                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="84" Height="84" CornerRadius="24" HorizontalAlignment="Center"
                            Background="{StaticResource SurfaceHiBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                        <TextBlock Text="&#xE7A8;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#A78BFA" Offset="0"/>
                                    <GradientStop Color="#22D3EE" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="Nothing caught yet" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,18,0,6"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="13" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360">
                        Click <Run Text="New Capture" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        or press <Run Text="Ctrl+N" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>,
                        then drag a rectangle anywhere on your screens to catch it.
                    </TextBlock>
                </StackPanel>

                <!-- Preview -->
                <Viewbox x:Name="PreviewHost" Stretch="Uniform" StretchDirection="DownOnly" Margin="28,72,28,28"
                         Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform>
                        <ScaleTransform x:Name="PreviewScale"/>
                    </Viewbox.RenderTransform>
                    <Border BorderBrush="#40FFFFFF" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.55" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Image x:Name="PreviewImage" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- Text annotations live here; flattened into the image on Copy / Save -->
                            <Canvas x:Name="AnnotationCanvas" Background="Transparent" ClipToBounds="True"
                                    MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
                                    MouseMove="AnnotationCanvas_MouseMove"
                                    MouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp"
                                    LostMouseCapture="AnnotationCanvas_LostMouseCapture"/>
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- Annotation toolbar -->
                <Border x:Name="AnnotateBar" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                        CornerRadius="12" Padding="5" Visibility="Collapsed"
                        Background="#F01A1C26" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TextToolButton" Style="{StaticResource BaseButton}" Focusable="False" Padding="12,7"
                                Click="TextToolButton_Click" ToolTip="Add text (T) – then click on the image to type">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D2;" Style="{StaticResource IconText}"/>
                                <TextBlock Text="Text"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ArrowToolButton" Style="{StaticResource BaseButton}" Focusable="False" Padding="12,7"
                                Margin="6,0,0,0" Click="ArrowToolButton_Click" ToolTip="Add arrow (A) – then drag on the image">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72A;" Style="{StaticResource IconText}"/>
                                <TextBlock Text="Arrow"/>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="ColorSwatches" Orientation="Horizontal" Margin="10,0,4,0" VerticalAlignment="Center"/>
                        <Rectangle Width="1" Fill="{StaticResource StrokeBrush}" Margin="6,4"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE738;" Click="FontSmaller_Click" ToolTip="Smaller (text size / arrow thickness)"/>
                        <TextBlock x:Name="FontSizeText" Width="28" TextAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold" Text="24"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" Click="FontLarger_Click" ToolTip="Larger (text size / arrow thickness)"/>
                        <Rectangle Width="1" Fill="{StaticResource StrokeBrush}" Margin="6,4"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Click="Undo_Click" ToolTip="Undo last annotation (Ctrl+Z)"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="ClearText_Click" ToolTip="Remove all annotations"/>
                    </StackPanel>
                </Border>

                <!-- Toast -->
                <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                        CornerRadius="10" Padding="14,9" Opacity="0" IsHitTestVisible="False"
                        Background="#F0242735" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock x:Name="ToastText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource MutedBrush}" Text="Ready"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyButton" Style="{StaticResource BaseButton}" IsEnabled="False"
                        Click="CopyButton_Click" ToolTip="Copy to clipboard (Ctrl+C)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}"/>
                        <TextBlock Text="Copy"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource BaseButton}" IsEnabled="False" Margin="10,0,0,0"
                        Click="SaveButton_Click" ToolTip="Save as image file (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource IconText}"/>
                        <TextBlock Text="Save As…"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
