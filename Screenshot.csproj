<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the system tray NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>Screenshot</AssemblyName>
    <RootNamespace>Screenshot</RootNamespace>
    <Product>Capture Everything</Product>
    <!-- WPF app: DPI awareness belongs in app.manifest, not WinForms' ApplicationHighDpiMode. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid WPF/WinForms name clashes (Application, MessageBox, Clipboard, Point, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Store packaging output and scripts (see Packaging/Build-Msix.ps1) are not part of the app. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);dist/**;Packaging/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
