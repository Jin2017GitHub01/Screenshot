<Window x:Class="Screenshot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setting" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic, Yu Gothic UI, Microsoft YaHei UI, Nirmala UI" UseLayoutRounding="True">
    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="HeaderTitle" Text="Setting" FontSize="18" FontWeight="Bold"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Shortcut card -->
        <Border Grid.Row="1" Margin="0,18,0,0" CornerRadius="14" Padding="16,14"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="ShortcutHeaderText" Text="Shortcut" FontSize="14" FontWeight="SemiBold"/>
                <Button x:Name="PrintScreenToggleButton" Style="{StaticResource BaseButton}"
                        Padding="12,10" Margin="0,10,0,8" HorizontalContentAlignment="Stretch"
                        Click="PrintScreenToggleButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PrintScreenCheckBox" Width="18" Height="18" CornerRadius="5"
                                BorderThickness="1.5" BorderBrush="{StaticResource StrokeBrush}"
                                VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="PrintScreenCheckIcon" Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="PrintScreenLabelText" Grid.Column="1"
                                   Text="Use the Print Screen key to capture screen"
                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <TextBlock x:Name="PrintScreenDescText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           TextWrapping="Wrap"
                           Text="When turned off, pressing Print Screen uses the default Windows Snipping Tool."/>
            </StackPanel>
        </Border>

        <!-- Language card -->
        <Border Grid.Row="2" Margin="0,14,0,18" CornerRadius="14" Padding="16,14"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="LangHeaderText" Text="Language" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="LangDescText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,4,0,12"
                           Text="Choose the display language for menus, buttons, and messages."/>

                <UniformGrid x:Name="LanguageGrid" Columns="2" Margin="-4"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Button x:Name="CloseButton" Grid.Row="3" Style="{StaticResource BaseButton}"
                HorizontalAlignment="Right" MinWidth="92" Click="CloseButton_Click" Content="Close"/>
    </Grid>
</Window>
